---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import HeContact from "../components/he/Contact.astro";
import { whatsappUrl } from "../data/he";

interface Props {
  title: string;
  description?: string;
  lang?: "en" | "he";
}

const { title, description = "Senior product designer with engineering background, experienced in research, growth, and complex products.", lang = "en" } = Astro.props;
const he = lang === "he";

// link previews (LinkedIn, WhatsApp, Slack) need absolute URLs; Astro.site is set in astro.config.mjs
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL("/og-image.png", Astro.site ?? Astro.url);
// the two home pages are the only true equivalents (the Hebrew section has its own structure)
const isHome = ["/", "/he", "/he/"].includes(Astro.url.pathname);
---

<html lang={lang} dir={he ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png?v=4" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mor Naveh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mor Naveh logo" />
    <meta name="twitter:card" content="summary_large_image" />
    {
      isHome && (
        <>
          <link rel="alternate" hreflang="en" href={new URL("/", Astro.site ?? Astro.url)} />
          <link rel="alternate" hreflang="he" href={new URL("/he", Astro.site ?? Astro.url)} />
          <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site ?? Astro.url)} />
        </>
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={he
        ? "https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;500;600;700&family=Amatic+SC:wght@400;700&display=swap"
        : "https://fonts.googleapis.com/css2?family=Albert+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,500&family=Bad+Script&display=swap"}
      rel="stylesheet"
    />
  </head>
  <body class="font-body antialiased">
    <Nav lang={lang} />
    <slot />
    {he && <HeContact />}
    <Footer lang={lang} />
    {
      he && (
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener"
          aria-label="וואטסאפ"
          class="fixed end-6 bottom-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25d366] text-white shadow-lg transition-transform hover:scale-105"
        >
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.04 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.57.93.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.23-9.43 9.44-9.43 2.52 0 4.89.98 6.67 2.77a9.36 9.36 0 0 1 2.76 6.67c0 5.2-4.23 9.43-9.44 9.43m8.03-17.46A11.27 11.27 0 0 0 12.04.72C5.79.72.7 5.8.7 12.06c0 2 .52 3.95 1.52 5.67L.6 23.6l6-1.57a11.3 11.3 0 0 0 5.43 1.38h.01c6.25 0 11.34-5.08 11.34-11.34 0-3.03-1.18-5.88-3.32-8.02" />
          </svg>
        </a>
      )
    }
  </body>
</html>
