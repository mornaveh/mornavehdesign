---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  tagline: string;
  accent: "indigo-soft" | "rose-soft" | "sage-soft" | "amber-soft";
  prototypeUrl?: string;
  heroImage?: string;
  summary?: {
    logo: string;
    logoAlt: string;
    dateLine: string;
    headline: string;
    body: string[];
    workSteps?: string[];
  };
}

const { title, tagline, accent, prototypeUrl, heroImage, summary } = Astro.props;
// literal var(...) strings, not built via interpolation, so Tailwind's scanner
// keeps these @theme tokens instead of tree-shaking them as unused
const paleAccentVar = {
  "indigo-soft": "var(--color-indigo-pale)",
  "rose-soft": "var(--color-rose-pale)",
  "sage-soft": "var(--color-sage-pale)",
  "amber-soft": "var(--color-amber-pale)",
}[accent];
---

<Layout title={`${title} — Mor Naveh`} description={tagline}>
  {
    heroImage && (
      <section class="mx-auto max-w-[1400px] px-6 pt-16">
        <img src={heroImage} alt="" class="mx-auto w-[60%]" />
      </section>
    )
  }

  {
    summary ? (
      <section class="mx-auto max-w-[1400px] px-6 pt-16">
        <div class="grid gap-10 md:grid-cols-[1fr_280px]">
          <div>
            <img src={summary.logo} alt={summary.logoAlt} class="h-7 w-auto" />
            <p class="font-hand mt-8 text-xl font-normal text-ink/60">{summary.dateLine}</p>
            <h1 class="font-display mt-5 text-5xl font-normal text-balance text-ink">{summary.headline}</h1>
            <div class="mt-8 flex max-w-xl flex-col gap-5 text-sm text-ink/70">
              {summary.body.map((p, i) => (
                <p class={i === summary.body.length - 1 ? "font-semibold text-ink" : ""}>{p}</p>
              ))}
            </div>
          </div>
          <div class="flex flex-col gap-6">
            {summary.workSteps && (
              <div class="aspect-square flex flex-col justify-center rounded-2xl p-6" style={`background: ${paleAccentVar};`}>
                <p class="font-hand text-xl font-normal text-ink">My work</p>
                <ul class="mt-4 flex flex-col gap-2.5 text-sm text-ink/80">
                  {summary.workSteps.map((step) => (
                    <li>{step}</li>
                  ))}
                </ul>
              </div>
            )}
            {prototypeUrl && (
              <a
                href={prototypeUrl}
                target="_blank"
                rel="noreferrer"
                class="flex flex-col gap-3 rounded-2xl bg-ink/[0.03] p-5 transition-colors hover:bg-ink/[0.06]"
              >
                <div class="flex items-start gap-4">
                  <img src="/images/prototype-illustration.png" alt="" class="h-14 w-auto shrink-0" />
                  <p class="text-sm font-medium text-ink underline underline-offset-4">
                    Get a feel for the project through an interactive AI prototype
                  </p>
                </div>
                <div>
                  <p class="text-xs text-muted">
                    The AI prototype demonstrates the product's behavior rather than an exact replica of the designs.
                  </p>
                </div>
              </a>
            )}
          </div>
        </div>
      </section>
    ) : (
      <section class={`mx-auto max-w-[1400px] px-6 ${heroImage ? "pt-10" : "pt-16"}`}>
        <div class="rounded-3xl p-10 md:p-14" style={`background: var(--color-${accent});`}>
          <h1 class="font-display text-5xl font-normal text-balance text-ink">{title}</h1>
          <p class="mt-4 max-w-2xl text-lg font-light text-ink/70">{tagline}</p>
        </div>
      </section>
    )
  }

  <article class="mx-auto max-w-[1400px] px-6 pb-28">
    <slot />
  </article>
</Layout>
