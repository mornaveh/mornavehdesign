---
import Layout from "./Layout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Section from "../components/casestudy/Section.astro";
import { projects } from "../data/projects";

interface Props {
  title: string;
  tagline: string;
  accent: "indigo-soft" | "rose-soft" | "sage-soft" | "amber-soft";
  prototypeUrl?: string;
  heroImage?: string;
  heroImageClass?: string;
  plainCta?: boolean;
  summary?: {
    logo: string;
    logoAlt: string;
    dateLine: string;
    headline: string;
    body: string[];
    workSteps?: string[];
  };
}

const { title, tagline, accent, prototypeUrl, heroImage, heroImageClass = "w-[60%]", summary, plainCta } = Astro.props;
// literal var(...) strings, not built via interpolation, so Tailwind's scanner
// keeps these @theme tokens instead of tree-shaking them as unused
const accentVar = {
  "indigo-soft": "var(--color-indigo-soft)",
  "rose-soft": "var(--color-rose-soft)",
  "sage-soft": "var(--color-sage-soft)",
  "amber-soft": "var(--color-amber-soft)",
}[accent];

// next two published case studies, wrapping from the last back to the first
const published = projects.filter((p) => p.href);
const current = published.findIndex((p) => p.href === Astro.url.pathname.replace(/\/$/, ""));
const more = [1, 2].map((n) => published[(current + n) % published.length]).filter((p, i, a) => p !== published[current] && a.indexOf(p) === i);
---

<Layout title={`${title} — Mor Naveh`} description={tagline}>
  {
    heroImage && (
      <section class="mx-auto max-w-[1400px] px-6 pt-16">
        <img src={heroImage} alt="" class={`mx-auto rounded-3xl ${heroImageClass}`} />
      </section>
    )
  }

  {
    summary ? (
      <section class="mx-auto max-w-[1400px] px-6 pt-16">
        <img src={summary.logo} alt={summary.logoAlt} class="h-7 w-auto" />
        <p class="font-hand mt-8 text-xl font-normal text-ink/60">{summary.dateLine}</p>
        <div class="mt-5 grid gap-10 md:grid-cols-[1fr_280px]">
          <div>
            <h1 class="max-w-[850px] font-display text-5xl leading-[1.1] font-normal text-pretty text-ink">{summary.headline}</h1>
            <div class="mt-8 flex max-w-xl flex-col gap-5 text-sm text-ink/80">
              {summary.body.map((p, i) => (
                <p class={i === summary.body.length - 1 ? "font-semibold text-ink" : ""}>{p}</p>
              ))}
            </div>
          </div>
          <div class="flex flex-col gap-6">
            {summary.workSteps && (
              <div class="flex flex-col rounded-2xl p-6" style={`background: ${accentVar};`}>
                <p class="font-hand text-xl font-semibold text-ink">My work</p>
                <ul class="mt-4 flex flex-col gap-2.5 text-sm text-ink/80">
                  {summary.workSteps.map((step) => (
                    <li>{step}</li>
                  ))}
                </ul>
              </div>
            )}
            {prototypeUrl && (
              <a
                href={prototypeUrl}
                target="_blank"
                rel="noreferrer"
                class="flex flex-col gap-3 rounded-2xl bg-ink/[0.03] p-5 transition-colors hover:bg-ink/[0.06]"
              >
                <div class="flex items-center gap-4">
                  <img src="/images/prototype-illustration.png" alt="" class="h-14 w-auto shrink-0" />
                  <p class="text-sm font-medium text-ink underline underline-offset-4">
                    Get a feel for the project through an interactive AI prototype
                  </p>
                </div>
                <div>
                  <p class="text-xs text-muted">
                    The AI prototype demonstrates the product's behavior rather than an exact replica of the designs.
                  </p>
                </div>
              </a>
            )}
          </div>
        </div>
      </section>
    ) : (
      <section class={`mx-auto max-w-[1400px] px-6 ${heroImage ? "pt-10" : "pt-16"}`}>
        <div class="rounded-3xl p-10 md:p-14" style={`background: var(--color-${accent});`}>
          <h1 class="font-display text-5xl font-normal text-balance text-ink">{title}</h1>
          <p class="mt-4 max-w-2xl text-lg font-light text-ink/80">{tagline}</p>
        </div>
      </section>
    )
  }

  <article class="mx-auto max-w-[1400px] px-6 pb-16">
    <slot />
    <Section id="more-case-studies" title="More case studies">
      <div class="grid gap-6 md:grid-cols-2">
      {more.map((next) => (
      <a
        href={next.href}
        class="group flex flex-col rounded-3xl p-8 transition-transform hover:-translate-y-0.5"
        style={`background: var(--color-${next.color});`}
      >
        <span class="self-start rounded-full bg-bg/60 px-3 py-1 text-xs font-medium text-ink">{next.tag}</span>
        <h3 class="font-display mt-3 text-2xl font-semibold text-ink">{next.title}</h3>
        <p class="mt-3 text-sm text-ink/80">{next.description}</p>
        <p class="mt-auto pt-5 text-sm font-medium text-ink">
          Read case study <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
        </p>
      </a>
      ))}
      </div>
    </Section>
  </article>

  <section>
    <ContactCTA plain={plainCta} />
  </section>
</Layout>
