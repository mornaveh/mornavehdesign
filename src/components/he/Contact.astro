---
import { whatsappUrl } from "../../data/he";
---

<section id="contact" class="scroll-mt-24 py-20" style="background: var(--color-indigo-soft);">
  <div class="mx-auto flex max-w-[1400px] flex-col gap-8 px-6 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="font-display text-4xl font-normal text-ink">
        מה האתגר הבא שלך?
      </h2>
      <p class="mt-2 max-w-xl text-base text-ink/80">
        בואו נעצב מוצר שאנשים אוהבים להשתמש בו וכולם עומדים מאחוריו.<br />
        אשמח לשמוע על מה אתם עובדים.
      </p>
    </div>
    <div class="flex flex-wrap gap-4 whitespace-nowrap">
      <a href={whatsappUrl} target="_blank" rel="noopener" class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-ink/80">וואטסאפ</a>
      <a href="https://calendly.com/mornaveh/30min" target="_blank" rel="noopener" class="rounded-full border border-ink/30 bg-bg px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ink">
        לקביעת שיחה
      </a>
    </div>
  </div>
</section>
