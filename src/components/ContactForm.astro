---
const { tracks = [] }: { tracks?: string[] } = Astro.props;
---

<section id="contact" class="mx-auto max-w-[1400px] scroll-mt-24 px-6 pb-48">
  <h2 class="font-display text-4xl font-normal text-ink">How can I help?</h2>
  <p class="mt-2 max-w-xl text-base text-ink/80">Share what you're working on, and let's tackle it together.</p>
  <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="mt-10 grid max-w-2xl gap-5 sm:grid-cols-2">
    <input type="hidden" name="access_key" value="a3887519-6770-4ff8-9f42-7b48f27e77a7" />
    <input type="hidden" name="subject" value="New message from your portfolio" />
    <input type="hidden" name="from_name" value="Portfolio contact form" />
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
    <label class="flex flex-col gap-2 text-sm font-medium text-ink">
      Name
      <input name="name" required autocomplete="name" class="rounded-2xl border border-border px-4 py-3 font-normal focus:border-accent focus:outline-none" />
    </label>
    <label class="flex flex-col gap-2 text-sm font-medium text-ink">
      Email
      <input name="email" type="email" required autocomplete="email" pattern="[^@\s]+@[^@\s]+\.[^@\s]{2,}" aria-describedby="email-error" class="rounded-2xl border border-border px-4 py-3 font-normal focus:border-accent focus:outline-none aria-invalid:border-red-600!" />
      <span id="email-error" hidden class="font-normal text-red-600">Enter a valid email address</span>
    </label>
    <label class:list={["flex flex-col gap-2 text-sm font-medium text-ink", !tracks.length && "sm:col-span-2"]}>
      <span>Company <span class="font-normal text-muted">(optional)</span></span>
      <input name="company" autocomplete="organization" class="rounded-2xl border border-border px-4 py-3 font-normal focus:border-accent focus:outline-none" />
    </label>
    {
      tracks.length > 0 && (
        <label class="flex flex-col gap-2 text-sm font-medium text-ink">
          Track
          <select id="track" name="track" class="appearance-none rounded-2xl border border-border bg-bg bg-[length:16px] bg-[position:right_1rem_center] bg-no-repeat py-3 pr-10 pl-4 font-normal focus:border-accent focus:outline-none"
            style="background-image: url(&quot;data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231C1B2E' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='m6 9 6 6 6-6'/%3E%3C/svg%3E&quot;);">
            <option>Not sure yet</option>
            {tracks.map((t) => <option>{t}</option>)}
          </select>
        </label>
      )
    }
    <label class="flex flex-col gap-2 text-sm font-medium text-ink sm:col-span-2">
      <span>What's on your mind? <span class="font-normal text-muted">(optional)</span></span>
      <textarea name="message" rows="5" class="rounded-2xl border border-border px-4 py-3 font-normal focus:border-accent focus:outline-none"></textarea>
    </label>
    <button
      type="submit"
      class="w-fit rounded-full bg-ink px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-accent"
    >
      Send
    </button>
  </form>
  <div id="contact-status" role="status" hidden class="mt-10 max-w-2xl text-lg text-ink">
    <p></p>
    <button type="button" class="mt-4 cursor-pointer text-sm font-medium underline transition-colors hover:text-accent">Send another message</button>
  </div>
</section>

<script>
  const select = document.getElementById("track") as HTMLSelectElement | null;
  const track = new URLSearchParams(location.search).get("track");
  if (track && select) select.value = track;

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");
  const again = status?.querySelector("button");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const button = form.querySelector("button")!;
    button.disabled = true;
    // subject: "Name - first few words of the message", so enquiries are easy to tell apart
    const data = new FormData(form);
    const words = String(data.get("message") ?? "").trim().split(/\s+/).filter(Boolean);
    const preview = words.slice(0, 8).join(" ").slice(0, 60) + (words.length > 8 ? "…" : "");
    data.set("subject", [data.get("name"), preview].filter(Boolean).join(" - "));
    const ok = await fetch(form.action, {
      method: "POST",
      body: data,
      headers: { Accept: "application/json" },
    }).then(
      (r) => r.ok,
      () => false,
    );
    button.disabled = false;
    if (!status || !again) return;
    status.hidden = false;
    status.querySelector("p")!.textContent = ok
      ? "Thanks! Your message is on its way. I'll get back to you soon."
      : "Something went wrong. Please email me at mornavehdesign@gmail.com instead.";
    form.hidden = ok;
    again.hidden = !ok;
    if (ok) form.reset();
  });
  // Inline error instead of the browser's validation tooltip
  const email = form?.querySelector<HTMLInputElement>('input[name="email"]');
  const emailError = document.getElementById("email-error");
  const showEmailError = (show: boolean) => {
    email?.setAttribute("aria-invalid", String(show));
    if (emailError) emailError.hidden = !show;
  };
  email?.addEventListener("invalid", (e) => {
    e.preventDefault();
    showEmailError(true);
  });
  email?.addEventListener("input", () => {
    if (email.validity.valid) showEmailError(false);
  });
  email?.addEventListener("blur", () => {
    if (email.value) email.checkValidity();
  });
  again?.addEventListener("click", () => {
    if (!form || !status) return;
    form.hidden = false;
    status.hidden = true;
  });
</script>
