---
const { lang = "en" } = Astro.props;
const he = lang === "he";
const links: { label: string; href?: string; muted?: boolean; external?: boolean }[] = he
  ? [
      { label: "חברות וארגונים", href: "/he/organizations" },
      { label: "קהילה וחינוך", href: "/he/community" },
      { label: "עבודות", href: "/he/work" },
      { label: "קצת עליי", href: "/he/about" },
      { label: "קורות חיים", href: "https://drive.google.com/file/d/1pP5JQ7-eHlM2DqpZPzQCJwur9-aMOtov/view?usp=sharing", external: true },
    ]
  : [
      { label: "Case Studies", href: "/case-studies" },
      { label: "Services", href: "/services" },
      { label: "About", href: "/about" },
      { label: "Art", muted: true },
      { label: "Resume", href: "https://drive.google.com/file/d/1pP5JQ7-eHlM2DqpZPzQCJwur9-aMOtov/view?usp=sharing", external: true },
    ];
const home = he ? "/he" : "/";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
// subpages count too (a case study marks "Case Studies")
const isCurrent = (href?: string) => !!href && (path === href || path.startsWith(href + "/"));
const contact = he ? { label: "בואו נדבר", href: "#contact" } : { label: "Contact", href: "/about#contact" };
// links to the other language's home page, not a mirrored page: the two sections have different structures
// the English nav has no Hebrew link for now
const switcher = he && { label: "EN", href: "/", lang: "en" };
---

<header class="sticky top-0 z-50 border-b border-border bg-bg">
  <div class="mx-auto flex max-w-[1400px] items-center justify-between px-6 py-3">
    <a href={home}>
      <img src="/logo.png" alt="Mor Naveh" class="h-14 w-auto" />
    </a>

    <nav class="hidden items-center gap-8 text-sm font-medium md:flex">
      {
        links.map((link) =>
          link.href ? (
            <a
              href={link.href}
              {...(link.external && { target: "_blank", rel: "noopener" })}
              aria-current={isCurrent(link.href) ? "page" : undefined}
              class:list={[
                link.muted ? "text-muted/60 hover:text-muted transition-colors" : "text-ink hover:text-accent transition-colors",
                isCurrent(link.href) && "underline decoration-ink/70 decoration-[1.5px] underline-offset-[6px]",
              ]}
            >
              {link.label}
            </a>
          ) : (
            <span class="group relative cursor-default text-muted/60">
              {link.label}
              <span class="pointer-events-none absolute top-full left-1/2 z-10 mt-2 -translate-x-1/2 rounded-md bg-ink px-2 py-1 text-xs font-medium whitespace-nowrap text-bg opacity-0 transition-opacity group-hover:opacity-100">
                Coming soon
              </span>
            </span>
          )
        )
      }
      {switcher && <a href={switcher.href} lang={switcher.lang} class="text-muted hover:text-ink transition-colors">{switcher.label}</a>}
      <a href={contact.href} class="rounded-full border border-ink/30 px-5 py-2 text-ink transition-colors hover:border-ink">{contact.label}</a>
    </nav>

    <details id="mobile-nav" class="group md:hidden">
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-ink/30 text-ink [&::-webkit-details-marker]:hidden" aria-label={he ? "תפריט" : "Menu"}>
        <svg class="group-open:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg class="hidden group-open:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </summary>
      <nav class="absolute inset-x-0 top-full flex flex-col border-b border-border bg-bg px-6 pb-6 text-lg font-medium">
        {
          links.map((link) =>
            link.href ? (
              <a
                href={link.href}
                {...(link.external && { target: "_blank", rel: "noopener" })}
                aria-current={isCurrent(link.href) ? "page" : undefined}
                class:list={["border-b border-border py-4 text-ink", isCurrent(link.href) && "font-semibold"]}
              >{link.label}</a>
            ) : (
              <span class="flex items-center justify-between border-b border-border py-4 text-muted/60">
                {link.label}
                <span class="text-xs">Coming soon</span>
              </span>
            )
          )
        }
        {switcher && <a href={switcher.href} lang={switcher.lang} class="border-b border-border py-4 text-muted">{switcher.label}</a>}
        <a href={contact.href} class="mt-6 rounded-full border border-ink/30 px-6 py-3 text-center text-sm text-ink">{contact.label}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // close the phone menu after a tap, since same-page links (#contact) don't reload
  const menu = document.getElementById("mobile-nav") as HTMLDetailsElement | null;
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => (menu.open = false)));
</script>
