---
interface Props {
  title: string;
  icon: string;
  color: "indigo-soft" | "rose-soft" | "sage-soft" | "amber-soft";
}

const { title, icon, color } = Astro.props;
---

<div class="flex items-start gap-4">
  <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full" style={`background: var(--color-${color});`}>
    <img src={icon} alt="" class="h-[18px] w-[18px]" />
  </span>
  <div>
    <h3 class="font-display mt-0.5 text-lg font-semibold text-ink">{title}</h3>
    <div class="mt-2 flex flex-col gap-4 text-sm text-ink/80 [&_ul]:mt-1.5 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-4">
      <slot />
    </div>
  </div>
</div>
