---
interface Props {
  id: string;
  title: string;
  background?: "indigo-pale" | "rose-pale" | "sage-pale" | "amber-pale";
}

const { id, title, background } = Astro.props;
---

<section id={id} class="scroll-mt-24 pt-24">
  {
    background ? (
      <div class="relative left-1/2 w-screen -translate-x-1/2 pt-24 pb-24" style={`background: var(--color-${background});`}>
        <div class="mx-auto max-w-[1400px] px-6">
          <h2 class="font-display text-4xl font-normal text-ink">{title}</h2>
          <div class="mt-8 flex flex-col gap-16">
            <slot />
          </div>
        </div>
      </div>
    ) : (
      <>
        <h2 class="font-display text-4xl font-normal text-ink">{title}</h2>
        <div class="mt-8 flex flex-col gap-16">
          <slot />
        </div>
      </>
    )
  }
</section>
