---
interface Props {
  id: string;
  title?: string;
  eyebrow?: string;
  background?: "indigo-pale" | "rose-pale" | "sage-pale" | "amber-pale" | "indigo-soft" | "rose-soft" | "sage-soft" | "amber-soft";
}

const { id, title, eyebrow, background } = Astro.props;
---

<section id={id} class="scroll-mt-24 pt-36 [section:has(>[style])+&]:pt-24">
  {
    background ? (
      <div class="relative left-1/2 w-screen -translate-x-1/2 pt-24 pb-24" style={`background: var(--color-${background});`}>
        <div class="mx-auto max-w-[1400px] px-6">
          {eyebrow && <p class="font-hand text-xl font-normal text-ink/60">{eyebrow}</p>}
          {title && <h2 class="font-display text-4xl font-normal whitespace-pre-line text-ink">{title}</h2>}
          <div class:list={["flex flex-col gap-16", title && "mt-8"]}>
            <slot />
          </div>
        </div>
      </div>
    ) : (
      <>
        {eyebrow && <p class="font-hand text-xl font-normal text-ink/60">{eyebrow}</p>}
        {title && <h2 class="font-display text-4xl font-normal whitespace-pre-line text-ink">{title}</h2>}
        <div class:list={["flex flex-col gap-16", title && "mt-8"]}>
          <slot />
        </div>
      </>
    )
  }
</section>
