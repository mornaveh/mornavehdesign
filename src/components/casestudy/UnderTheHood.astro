---
interface Props {
  bodyClass?: string;
  label?: string;
}

const { bodyClass = "text-muted", label = "Under the hood (for the curious reader)" } = Astro.props;
---

<details class="group mt-3 rounded-xl bg-ink/[0.03] p-4">
  <summary class="cursor-pointer text-sm font-medium text-ink marker:content-none">
    <span class="inline-flex items-center gap-1.5">
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="transition-transform group-open:rotate-90"
      >
        <path d="m9 6 6 6-6 6" />
      </svg>
      {label}
    </span>
  </summary>
  <div class:list={["mt-3 text-sm [&_p]:mt-2 [&_p:first-child]:mt-0", bodyClass]}>
    <slot />
  </div>
</details>
