---
interface Props {
  title: string;
  color: "indigo-soft" | "rose-soft" | "sage-soft" | "amber-soft";
}

const { title, color } = Astro.props;
---

<div class="rounded-2xl p-6" style={`background: var(--color-${color});`}>
  <h3 class="font-display text-lg font-semibold text-ink">{title}</h3>
  <div class="mt-3 flex flex-col gap-4 text-sm text-ink/80 [&_ul]:mt-1.5 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-4">
    <slot />
  </div>
</div>
