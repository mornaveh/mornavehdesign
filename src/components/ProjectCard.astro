---
import type { projects } from "../data/projects";

interface Props {
  project: (typeof projects)[number];
  i: number;
}

const { project, i } = Astro.props;
const swatches = ["indigo-soft", "rose-soft", "sage-soft", "amber-soft"];
---

<article
  class="group relative grid gap-8 rounded-3xl p-8 transition-transform hover:-translate-y-0.5 md:grid-cols-2 md:items-center"
  style={`background: var(--color-${project.color ?? swatches[i % swatches.length]});`}
>
  <div class={i % 2 === 1 ? "md:order-2" : ""}>
    <span class="inline-block rounded-full bg-bg/60 px-3 py-1 text-xs font-medium text-ink">{project.tag}</span>
    <h3 class="font-display mt-3 text-2xl font-semibold text-ink">{project.title}</h3>
    <p class="mt-3 max-w-sm text-sm text-ink/80">{project.description}</p>
    <a
      href={project.href ?? "#"}
      class="mt-5 inline-flex items-center gap-1.5 rounded-full border border-ink/20 bg-bg px-5 py-2.5 text-sm font-medium text-ink transition-colors group-hover:border-ink after:absolute after:inset-0 after:rounded-3xl"
    >
      Read case study →
    </a>
  </div>
  <div
    class={`flex aspect-video items-center justify-center rounded-2xl ${project.image ? "" : "border border-ink/10 bg-bg/50"} ${i % 2 === 1 ? "md:order-1" : ""}`}
  >
    {project.image ? (
      <img src={project.image} alt={project.title} class="h-[85%] w-auto max-w-[90%] rounded-2xl object-contain" />
    ) : (
      <span class="text-xs text-ink/50">Project image</span>
    )}
  </div>
</article>
