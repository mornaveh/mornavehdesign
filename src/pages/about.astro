---
import Layout from "../layouts/Layout.astro";
import ContactCTA from "../components/ContactCTA.astro";

const swatches = ["indigo-soft", "rose-soft", "sage-soft", "amber-soft"] as const;

const contact = [
  { label: "Email", value: "mornaveh@gmail.com", href: "mailto:mornaveh@gmail.com" },
  { label: "Phone", value: "+972 54 790 5759", href: "tel:+972547905759" },
  { label: "LinkedIn", value: "in/mor-naveh", href: "https://il.linkedin.com/in/mor-naveh" },
  {
    label: "Resume",
    value: "View PDF",
    href: "https://drive.google.com/file/d/1cWux5zATPjghqlL11YaQIQB-9QXTh7QX/view?usp=sharing",
  },
];

const story = [
  "I've been an information systems engineer since 2006, and a product designer since 2016. I've worked with dozens of customers on complex systems, turning wishes, opinions and half-formed ideas into focused, user-friendly products.",
  "Today I help teams of every size, from startups to enterprise, find a clear direction and turn it into products that deliver results.",
];

const strengths = [
  {
    title: "Bring things into focus",
    body: "I help teams filter out the noise and refocus on what matters: the user and the business goal. Turning complex ideas into strategic UX, I keep our direction sharp, steady, and focused on real outcomes.",
  },
  {
    title: "Bridging the Gap",
    body: "When discussions misalign, I spot where communication breaks down and translate opposing viewpoints into a shared understanding.",
  },
  {
    title: "Designing through users' eyes",
    body: "After many years in design and research, I can instinctively tell what's confusing and what a good flow looks like (but I still do the research and check 🙂).",
  },
  {
    title: "Bringing everyone on the journey",
    body: "I ensure every voice in the room is heard. When the team shares ownership of a design, implementation goes smoothly and the project actually succeeds.",
  },
];

const offScreen = [
  "When I'm not designing, I'm probably out walking the lady of the house, stopping to say hello to the cats we meet along the way.",
  "I love being in nature and exploring new cities, taking in how people live somewhere completely different from home.",
  "Back home, I do crafts, design crochet patterns, and illustrate (more on that to come!)",
  "I've always loved art, keeping my hands busy and creating. Becoming a product designer was the next natural step, and I'm excited by what we can create together. Give me a call :)",
];
---

<Layout title="About — Mor Naveh">
  <section class="mx-auto grid max-w-[1000px] gap-16 px-6 pt-20 pb-28 md:grid-cols-[1fr_280px] md:items-center">
    <div>
      <p class="font-hand text-lg font-normal text-[#302e2c]/60">Hi, I'm Mor</p>
      <h1 class="font-display mt-6 text-5xl font-normal text-balance text-ink">
        Together, we'll turn complex discussions into clear, intuitive product design.
      </h1>
      <p class="mt-6 max-w-xl text-lg font-light text-ink/80">
        I'm a product designer based in Israel. I help teams find direction, bridge opposing viewpoints, and create user-centered experiences that are as seamless as they are strategic.
      </p>
      <dl class="mt-10 grid max-w-xl grid-cols-2 gap-x-8 gap-y-5 text-sm">
        {
          contact.map((c) => (
            <div>
              <dt class="text-muted">{c.label}</dt>
              <dd class="mt-1">
                <a
                  href={c.href}
                  target={c.href.startsWith("http") ? "_blank" : undefined}
                  rel={c.href.startsWith("http") ? "noopener" : undefined}
                  class="font-medium text-ink transition-colors hover:text-accent"
                >
                  {c.value}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="relative">
      <div
        class="absolute -inset-6 -z-10 rounded-[60%_40%_55%_45%/45%_55%_40%_60%]"
        style="background: linear-gradient(135deg, var(--color-rose-soft), var(--color-amber-soft));"
      >
      </div>
      <div class="aspect-4/5 overflow-hidden rounded-3xl border border-border bg-surface">
        <img src="/images/mor-photo.png" alt="Mor Naveh" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1000px] gap-6 px-6 pb-28 md:grid-cols-[240px_1fr]">
    <h2 class="font-display text-4xl font-normal text-ink">My story</h2>
    <div class="flex flex-col gap-4 text-base text-ink/80">
      {story.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="mx-auto grid max-w-[1000px] gap-6 px-6 pb-28 md:grid-cols-[240px_1fr]">
    <h2 class="font-display text-4xl font-normal text-ink">What I bring</h2>
    <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {
        strengths.map((s, i) => (
          <div class="flex gap-4">
            <span
              class="font-display inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-ink"
              style={`background: var(--color-${swatches[i % swatches.length]});`}
            >
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="font-display mt-1 text-base font-semibold text-ink">{s.title}</h3>
              <p class="mt-2 text-sm text-ink/80">{s.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto grid max-w-[1000px] gap-12 px-6 pt-20 pb-48 md:grid-cols-2 md:items-start">
    <div class="grid h-[420px] grid-cols-3 gap-3">
      <img src="/images/about-me1.jpg" alt="Mor walking down stone stairs on a green hillside" class="h-full w-full rounded-2xl object-cover" />
      <div class="flex min-h-0 flex-col gap-3">
        <img src="/images/about-me4.jpg" alt="Mor taking a selfie by a London bus" class="min-h-0 w-full flex-1 rounded-2xl object-cover" />
        <img src="/images/about-me3.jpg" alt="Mor petting a street cat" class="min-h-0 w-full flex-1 rounded-2xl object-cover" />
      </div>
      <img src="/images/about-me2.jpg" alt="Mor's dog on a walk" class="h-full w-full rounded-2xl object-cover" />
    </div>
    <div>
      <h2 class="font-display text-4xl font-normal text-ink">Off-screen</h2>
      <div class="mt-8 flex flex-col gap-4 text-base text-ink/80">
        {offScreen.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section id="contact" class="pb-48">
    <ContactCTA />
  </section>
</Layout>
