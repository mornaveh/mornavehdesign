---
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import Section from "../../components/casestudy/Section.astro";
import Figure from "../../components/casestudy/Figure.astro";
import NumberedPoint from "../../components/casestudy/NumberedPoint.astro";
import ColorCard from "../../components/casestudy/ColorCard.astro";
import IconItem from "../../components/casestudy/IconItem.astro";

const base = "/case-studies/security-db-search";

const flows = [
  {
    title: "Learning about a new vulnerability (searching for a CVE)",
    image: `${base}/flow-cve.png`,
    width: 1544,
    alt: "The user searches for a CVE, results show Application packages focusing on CVEs, the single right result appears, and the user can adjust the search to see more results",
  },
  {
    title: "Evaluating a package (searching for a package)",
    image: `${base}/flow-package.png`,
    width: 1851,
    alt: "The user searches for a package, search results show Application packages, most relevant results show with exact matches clearly labeled, and the user can adjust the results to show operating system packages and explore any CVE",
  },
  {
    title: "Exploring a package manager",
    image: `${base}/flow-package-manager.png`,
    width: 1427,
    alt: "The user clicks a package manager logo in the homepage, all relevant CVEs and packages appear in the search, and the user can filter by different Applications and operating systems",
  },
];
// All flow images share one height (186px), so sizing each relative to the widest keeps block height equal.
const widestFlow = Math.max(...flows.map((flow) => flow.width));
---

<CaseStudyLayout
  title="Security DB search"
  tagline="A search redesign built around what users are looking for"
  accent="sage-soft"
  heroImage={`${base}/hero-mockup.png`}
  plainCta
  summary={{
    logo: `${base}/snyk-logo.webp`,
    logoAlt: "Snyk",
    dateLine: "Security DB search, 2025",
    headline: "Redesigning search for a growing database",
    body: [
      "The Snyk Vulnerability Database helps developers and AppSec engineers evaluate open-source packages: how secure they are, how well maintained, how popular, and more. Originally it only supported packages with known vulnerabilities. Since users want to learn about every package they consider using, not just the vulnerable ones, the database needed expanding to include secure packages too.",
      "This expansion put new demands on the database's search, which already had usability challenges. It needed a redesign to handle both secure and vulnerable packages.",
      "I redesigned the search experience to support non-vulnerable packages and improve overall usability.",
    ],
    workSteps: ["Problem definition", "Current state research", "Goal definition", "Flow mapping", "Final designs"],
  }}
>
  <Section id="final-designs-preview" eyebrow="Before diving in" title="Some of the final designs" background="sage-pale">
    <div class="grid gap-10 md:grid-cols-2 md:items-start">
      <Figure
        src={`${base}/preview-exploration.png`}
        alt="Browsing the latest vulnerabilities in a package manager"
        caption="Staying up to date with the latest vulnerabilities discovered"
      />
      <div class="flex flex-col gap-10">
        <Figure
          src={`${base}/preview-cve-search.png`}
          alt="Search results for a CVE, showing a single vulnerability result"
          caption="Avoiding vulnerable, risky packages."
        />
        <Figure
          src={`${base}/preview-package-search.png`}
          alt="Package search results with health scores and status tags"
          caption="Finding healthy and up-to-date packages to use."
        />
      </div>
    </div>
  </Section>

  <Section id="pain-points" eyebrow="Back to the start" title="Understanding the problems with the current state">
    <div>
    <div class="grid gap-16 md:grid-cols-[1fr_1.4fr] md:items-end">
      <div>
        <div class="flex flex-col gap-8">
        <p class="text-sm text-ink/80">I researched the current state to make sure focus is being put on the right problems:</p>
          <NumberedPoint number={1} title="Secure packages are invisible" bodyClass="text-ink/80">
          <p>Results only include vulnerabilities, so packages without known vulnerabilities never appear, even once they're added to the database.</p>
        </NumberedPoint>
        <NumberedPoint number={2} title="Packages aren't standalone results" bodyClass="text-ink/80">
          <p>
            Searching for a package returns a separate entry for each of its vulnerabilities, so the same package
            appears many times (see the "Affects" column).
          </p>
        </NumberedPoint>
        <NumberedPoint number={3} title="CVE searches bury the source" bodyClass="text-ink/80">
          <p>
            A CVE search returns the package where the vulnerability originated, mixed in with many operating system packages that depend on it. This makes the original source hard to find.
          </p>
        </NumberedPoint>
        <NumberedPoint number={4} title="Package searches return the wrong packages" bodyClass="text-ink/80">
          <p>Open source packages with similar names crowd the results, hiding the package the user wanted.</p>
        </NumberedPoint>
        <p class="flex items-center gap-2 text-sm text-muted">
          Original search design
          <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full" style="background: var(--color-sage-soft);">
            <img src="/icons/arrow-right.png" alt="" class="h-[14px] w-[14px]" />
          </span>
        </p>
        </div>
      </div>
      <Figure src={`${base}/current-search.png`} alt="The current search design, a table of vulnerabilities" />
    </div>
    </div>
  </Section>

  <Section id="goals" title="I identified the key goals derived from the pain points">
    <div class="flex flex-col gap-10">
      <IconItem title="Find the right result, fast" icon="/icons/target.png" color="indigo-soft">
        <p>Help users quickly find and clearly identify the results they're looking for.</p>
      </IconItem>
      <IconItem title="Find any package, vulnerable or not" icon="/icons/package.png" color="rose-soft">
        <p>Include vulnerability-free packages in the search results.</p>
      </IconItem>
    </div>
  </Section>

  <Section id="research">
    <div class="grid gap-16 md:grid-cols-[1fr_1.4fr] md:items-start">
      <div>
        <h2 class="font-display text-4xl font-normal text-ink">Through research, I uncovered three main search scenarios</h2>
        <div class="mt-8 flex items-start gap-3">
          <svg width="26" height="20" viewBox="0 0 34 26" fill="none" class="shrink-0 text-ink/30">
            <path
              fill="currentColor"
              d="M0 26V15.6C0 11.1 1.1 7.4 3.3 4.4 5.6 1.5 8.9 0 13.2 0v5.6c-2.2 0-3.9.8-5.1 2.4C6.9 9.4 6.3 11.4 6.3 13.8h6.9V26H0Zm18.5 0V15.6c0-4.5 1.1-8.2 3.3-11.2C24.1 1.5 27.3 0 31.5 0v5.6c-2.1 0-3.8.8-5.1 2.4-1.2 1.4-1.8 3.4-1.8 5.8h6.9V26H18.5Z"
            />
          </svg>
          <p class="font-accent text-lg text-ink italic">I need Snyk to help me vet an open source package based on its parameters.</p>
        </div>
      </div>
      <div class="flex flex-col gap-6">
        <ColorCard title="Learning about a new vulnerability" color="indigo-soft">
          <p>The user (usually an AppSec engineer) discovers a newly disclosed vulnerability and wants to learn about it and the packages it affects.</p>
        </ColorCard>
        <ColorCard title="Evaluating a package" color="rose-soft">
          <p>The user (usually a developer) wants to evaluate a package's security status and health before deciding to use it.</p>
        </ColorCard>
        <ColorCard title="Exploring a package manager" color="amber-soft">
          <p>The user (for example, a security researcher) wants to explore different package managers to check for newly discovered vulnerabilities.</p>
        </ColorCard>
      </div>
    </div>
  </Section>

  <Section id="user-flows" title="A logical search flow for each use case">
    <p class="-mb-8 text-sm text-ink/80">To make sure the designs cater to the user needs, I mapped the desirable flow for each scenario:</p>
    {
      flows.map((flow) => (
        <div>
          <p class="text-lg font-normal text-ink">{flow.title}</p>
          <div class="mt-5 max-w-4xl">
            <img src={flow.image} alt={flow.alt} style={`width: ${(flow.width / widestFlow) * 100}%`} />
          </div>
        </div>
      ))
    }
  </Section>

  <Section id="designs" eyebrow="The new designs" title="The new search: a faster path to the right answer">
    <div>
      <p class="-mt-4 text-sm text-ink/80">Letting the user goals lead the way, the needed design changes were clear enough: </p>
      <div class="mt-16 flex flex-col gap-24">
        <div class="grid gap-16 md:grid-cols-[3fr_2fr] md:items-center">
          <Figure src={`${base}/design-cve-1.png`} alt="CVE search showing the vulnerability result with Has fix tag" />
          <div>
            <h3 class="font-display text-4xl font-normal text-ink">Finding the right CVE faster</h3>
            <ol class="mt-4 flex list-decimal flex-col gap-3 pl-5 text-sm text-ink/80">
              <li><span class="font-semibold text-ink">Application filter on by default.</span> Users are most likely looking for the application package, so that result comes first.</li>
              <li><span class="font-semibold text-ink">"See operating system results" link added.</span> If the default result isn't what the user was looking for, there's easy access to the rest.</li>
              <li><span class="font-semibold text-ink">Severity and "Has fix" added on each CVE.</span> Users can quickly assess the risk and the effort to fix it.</li>
            </ol>
          </div>
        </div>
       <div class="grid gap-16 md:grid-cols-[2fr_3fr] md:items-center">
          <div>
            <h3 class="font-display text-4xl font-normal text-ink">Finding and assessing packages is faster and easier</h3>
            <ol class="mt-4 flex list-decimal flex-col gap-3 pl-5 text-sm text-ink/80">
              <li><span class="font-semibold text-ink">Non-vulnerable packages appear in the search.</span> Previously, only packages with vulnerabilities were returned.</li>
              <li><span class="font-semibold text-ink">Exact matches are marked for quicker recognition</span></li>
              <li><span class="font-semibold text-ink">Security status, health score and description added. </span>Users can now assess relevance without opening the package page.</li>
              <li><span class="font-semibold text-ink">"Affected by" added.</span> Packages are tied to the CVEs that affect them. The lodash screen doesn't show this, so add a small cropped inset of one row from the CVE search's Packages tab.</li>
            </ol>
          </div>
          <Figure src={`${base}/design-package-lodash.png`} alt="Package search results for lodash with exact match labels, security tags and health scores" />
        </div>
        <div class="grid gap-16 md:grid-cols-[3fr_2fr] md:items-center">
          <Figure src={`${base}/design-package-manager.png`} alt="Browsing all results for a package manager with filters" />
          <div>
            <h3 class="font-display text-4xl font-normal text-ink">Browsing with a purpose - focusing on the most important information</h3>
            <p class="mt-4 text-sm text-ink/80">Whether looking for the most recent vulnerabilities, or browsing to discover new packages, the added information and filtering helps.<br />It's visible right away which vulnerabilities can be fixed, how packages are affected by them, and how recent they are.</p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section id="next-steps" eyebrow="Next steps" title="Part of a bigger initiative" background="rose-pale">
    <div class="flex max-w-2xl flex-col gap-4 text-sm text-ink/80">
      <p>
        These designs are part of a broader initiative to include non-vulnerable packages in the Snyk Vulnerability
        Database, now renamed the Snyk Security Database. I also redesigned the package page to bring in
        information from other Snyk domains, as well as the homepage to add the latest Snyk branding and several UX
        improvements. I'd be glad to walk through these on request.
      </p>
    </div>
  </Section>
</CaseStudyLayout>
