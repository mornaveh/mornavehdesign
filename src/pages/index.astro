---
import Layout from "../layouts/Layout.astro";
import Testimonials from "../components/Testimonials.astro";
import ContactCTA from "../components/ContactCTA.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import { logos } from "../data/logos";


const swatches = ["indigo-soft", "rose-soft", "sage-soft", "amber-soft"] as const;

const process = [
  {
    step: "01",
    title: "Discover",
    description:
      "Every project starts with curiosity. I get to know your business, your users, and the thinking behind the product, because good design comes from understanding the real problem before thinking about solutions.",
  },
  {
    step: "02",
    title: "Focus",
    description:
      "Next, I narrow things down to what matters most and gather product, engineering, and stakeholders around that shared focus. A clear direction early on keeps the work moving quickly and smoothly.",
  },
  {
    step: "03",
    title: "Explore and validate",
    description:
      "I like to make ideas tangible early and put them in front of real users using prototypes. Testing early turns assumptions into evidence, and catches problems while they're still easy and inexpensive to fix.",
  },
  {
    step: "04",
    title: "Deliver",
    description:
      "I design with implementation in mind: clear, polished, and ready to build. Delivery isn't the end of the process, though. As real feedback and data come in, we keep iterating and refining, so the product keeps delivering on your business goals.",
  },
];
---

<Layout title="Mor Naveh Product Designer">
  <section class="mx-auto grid max-w-[1400px] grid-cols-[104px_1fr] items-center gap-x-6 px-6 pt-14 pb-32 md:grid-cols-[320px_1fr] md:gap-24 md:pt-20">
    <div class="relative row-span-2 md:row-span-1">
      <div
        class="absolute -inset-3 -z-10 rounded-[60%_40%_55%_45%/45%_55%_40%_60%] md:-inset-6"
        style="background: linear-gradient(135deg, var(--color-rose-soft), var(--color-amber-soft));"
      >
      </div>
      <div class="aspect-4/5 overflow-hidden rounded-2xl border border-border bg-surface md:rounded-3xl">
        <img src="/images/mor-photo.webp" alt="Mor Naveh" class="h-full w-full object-cover" />
      </div>
    </div>

    <!-- phones: `contents` lets the greeting sit beside the small photo while the rest spans full width -->
    <div class="contents md:block">
      <p class="font-hand self-end text-xl font-normal text-ink/60 md:text-lg">Hi, I'm Mor</p>
      <h1 class="font-display mt-2 self-start text-[1.75rem] leading-[1.15] font-normal text-ink md:mt-6 md:text-6xl md:leading-none md:text-balance">
        I make complex things feel <span class="font-hand font-normal">simple</span>.
      </h1>
      <p class="col-span-2 mt-8 text-base text-ink/80 md:mt-6">
        With 10+ years designing complex enterprise products, I translate intricate requirements into clear, dev-ready flows your users love.
      </p>
      <div class="col-span-2 mt-8 flex flex-wrap gap-4 whitespace-nowrap">
        <a href="https://calendly.com/mornaveh/30min" target="_blank" rel="noopener" class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-ink/80">
          Book a free intro call
        </a>
        <a href="/services" class="rounded-full border border-border px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ink">
          View services
        </a>
      </div>
    </div>
  </section>

  <section class="mb-32 bg-surface">
    <div class="mx-auto flex max-w-[1400px] flex-wrap items-center justify-center gap-x-10 gap-y-4 px-6 py-6">
      <p class="font-hand text-lg text-ink/60">Experience includes:</p>
      <ul class="flex flex-wrap items-center gap-x-10 gap-y-6">
        {logos.map((l) => (
          <li>
            <img src={`/logos/${l.file}`} alt={l.name} class={`${l.h} w-auto opacity-60 grayscale mix-blend-multiply transition hover:opacity-100 hover:grayscale-0`} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="work" class="mx-auto max-w-[1400px] px-6 pb-48">
    <h2 class="font-display text-4xl font-normal text-ink">Selected work</h2>
    <div class="mt-8 flex flex-col gap-6">
      {
        projects.slice(0, 3).map((project, i) => (
          <ProjectCard project={project} i={i} />
        ))
      }
    </div>
    <div class="mt-10 flex justify-center">
      <a href="/case-studies" class="rounded-full border border-ink/30 px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ink">
        View all case studies →
      </a>
    </div>
  </section>

  <Testimonials />

  <section class="pb-40">
    <div class="relative left-1/2 w-screen -translate-x-1/2 py-16" style="background: var(--color-sage-soft);">
      <div class="mx-auto max-w-[1400px] px-6">
        <div class="mx-auto grid max-w-[1000px] grid-cols-[8fr_7fr] gap-4 md:grid-cols-[200px_175px_1fr] md:items-start md:gap-6">
          <div class="overflow-hidden rounded-2xl border border-border">
            <img src="/images/mor-about.webp" alt="Mor Naveh" class="h-auto w-full" />
          </div>
          <div class="flex flex-col gap-4 md:gap-6">
            <div class="overflow-hidden rounded-2xl border border-border">
              <img src="/images/mor-about-2.webp" alt="Mor Naveh in a witch costume" class="h-auto w-full" />
            </div>
            <div class="overflow-hidden rounded-2xl border border-border">
              <img src="/images/mor-about-3.webp" alt="Mor Naveh with her dog" class="h-auto w-full" />
            </div>
          </div>
          <div class="col-span-2 mt-4 md:col-span-1 md:mt-0">
            <h2 class="font-display text-4xl font-normal text-ink">About me</h2>
            <p class="mt-3 text-base text-ink/80">
              I'm a product designer based in Tel Aviv, and I've been an information systems engineer since 2006. I help teams of every size turn complex ideas into clear, user-friendly products that deliver results.<br />Off-screen, I'll be walking my dog, hunting for good desserts, or counting down the days to Halloween.
            </p>
            <a
              href="/about"
              class="mt-5 inline-flex items-center gap-1.5 rounded-full border border-ink/20 bg-bg px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-ink"
            >
              More about me →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 pb-48">
    <h2 class="font-display text-center text-4xl font-normal text-ink">My process</h2>
    <div class="mx-auto mt-8 flex max-w-2xl flex-col">
      {
        process.map((p, i) => (
          <div class="flex gap-5">
            <div class="flex flex-col items-center">
              <span
                class="font-display inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-ink"
                style={`background: var(--color-${swatches[i % swatches.length]});`}
              >
                {p.step}
              </span>
              {i < process.length - 1 && <span class="my-2 w-px grow bg-border" />}
            </div>
            <div class={i < process.length - 1 ? "pb-10" : ""}>
              <h3 class="font-display mt-1 text-base font-semibold text-ink">{p.title}</h3>
              <p class="mt-2 text-base text-muted">{p.description}</p>
            </div>
          </div>
        ))
      }
    </div>
    <div class="mt-14 flex flex-col items-center gap-4 text-center">
      <p class="text-base text-ink/80">Curious about what working together looks like?</p>
      <a
        href="/services#hello-to-handoff"
        class="inline-flex items-center gap-1.5 rounded-full border border-ink/20 bg-bg px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-ink"
      >
        See the steps →
      </a>
    </div>
  </section>


  <section>
    <ContactCTA />
  </section>
</Layout>
