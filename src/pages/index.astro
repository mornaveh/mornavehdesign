---
import Layout from "../layouts/Layout.astro";
import Testimonial from "../components/Testimonial.astro";
import ContactCTA from "../components/ContactCTA.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";

const swatches = ["indigo-soft", "rose-soft", "sage-soft", "amber-soft"] as const;

const process = [
  {
    step: "01",
    title: "Discover",
    description:
      "Every project starts with curiosity. I get to know your business, your users, and the thinking behind the product, because good design comes from understanding the real problem before thinking about solutions.",
  },
  {
    step: "02",
    title: "Focus",
    description:
      "Next, I narrow things down to what matters most and gather product, engineering, and stakeholders around that shared focus. A clear direction early on keeps the work moving quickly and smoothly.",
  },
  {
    step: "03",
    title: "Explore and validate",
    description:
      "I like to make ideas tangible early and put them in front of real users using prototypes. Testing early turns assumptions into evidence, and catches problems while they're still easy and inexpensive to fix.",
  },
  {
    step: "04",
    title: "Deliver",
    description:
      "I design with implementation in mind: clear, polished, and ready to build. Delivery isn't the end of the process, though. As real feedback and data come in, we keep iterating and refining, so the product keeps delivering on your business goals.",
  },
];

const testimonials = [
  {
    quote:
      "Mor is a fantastic collaborator and asset to any projects I've had the pleasure of working with her on.\nShe is able to get to the core of any problem areas or requirements, and create design artefacts that both meet objectives as well as excelling in advising and offering her expertise on areas such as wording choices and iconography usage.\nMor is quick to respond to any changes in scope, and always happy to work closely with both product and engineering to ensure that the final product is polished and professional.",
    name: "Eleanor Demetriou",
    title: "Senior Software Engineer",
    company: "Snyk",
  },
  {
    quote: "Mor has a rare ability to turn ambiguous ideas and raw user feedback into clear, intuitive products, and she does it fast without ever compromising on quality. She's a true partner to product. A great example is Proxymity, a proxy-voting platform for institutional clients. Mor was its UX lead, and it grew from a sketch in one of our workshops into a platform that transformed the global proxy-voting industry.\nWorking with Mor made me a better PM.",
    name: "Limor Peleg",
    title: "Product Manager, Agentic Solutions",
    company: "Workday",
  },
  {
    quote:
      "I have worked both directly and indirectly with Mor my entire time at Snyk.\nShe is an incredible thoughtful and empathetic designer, always championing the user and always asking why (at least five times 😊). She is extremely collaborative, both within her teams and with her peers and loves teaching and showing others what she has learned herself.\nI can thoroughly recommend Mor to anyone who needs a brilliant product designer and a brilliant human!",
    name: "Jakob Bhul",
    title: "Product Designer",
    company: "Snyk",
  },
  {
    quote: `Mor is a highly adaptive, details-focused, and user-oriented product designer who puts the work in to understand deeply technical domains, and who has helped make the design team at Snyk more effective by creating AI Skills for Claude that the whole team now uses.

As one of our most capable designers Mor has worked across Snyk from our Growth to our Application Security teams. From helping clients sign up, helping engineers get started, to defining new cross-platform product capabilities and functionality.

Most recently, Mor was responsible for the user experience around the Consistent Ignores project; the context for which included inconsistencies within product capabilities from one interface to the other, and between products. She worked tightly with the Product Manager and Engineers, collaborating to understand and align on the problem and possible solutions, and understanding the problem space through research, before designing the cross-platform approach and interfaces.  The impact of her work led directly to a reduction in the noise faced by developer and App-Sec teams, improving the relationship between those teams by reducing friction, and increasing confidence through a single source of truth.

Mor also worked to help create and improve several Claude Skills for design. Taking an early Skill that attempted to create designs based on Snyk's design system, Mor identified that while the outputs looked right Claude was in fact producing hard-coded elements rather than using the actual components. As well as improving the output of the skill she worked on an eval which was used to improve the skill over time with each usage. All of this being properly versioned and distributed via git. The impact of this was that designers (and in fact anyone in the company) could produce prototypes for discussion within teams and for user feedback in a matter of minutes - not just reducing the time taken to produce and evaluate prototypes, but also increasing the functionality that could be prototyped, and making the prototypes appropriately believable for richer feedback.

As well as being an excellent Product Designer (and producer of crochet patterns and sketch artist), Mor is a deeply caring colleague and friend, a supportive collaborator and team-player.`,
    name: "Karl Sabino",
    title: "Design Manager",
    company: "Snyk",
  },
  {
    quote:
      "I've had the pleasure of working with Mor on a couple of projects during my time at Snyk, and it's always been an exceptional experience.\nShe is so dedicated to being embedded with the team so there's no misalignment, and her output is both high quality and rapidly delivered.\nI think the best thing about working with Mor is that she is user hungry, and will be on every call possible to ensure the product and engineering team has absolute confidence in the experience she is delivering, as it's constantly validated.",
    name: "Waleed Arshad",
    title: "Staff Product Manager",
    company: "Snyk",
  },];
---

<Layout title="Mor Naveh — Product Designer">
  <section class="mx-auto grid max-w-[1400px] gap-24 px-6 pt-20 pb-48 md:grid-cols-[320px_1fr] md:items-center">
    <div class="relative">
      <div
        class="absolute -inset-6 -z-10 rounded-[60%_40%_55%_45%/45%_55%_40%_60%]"
        style="background: linear-gradient(135deg, var(--color-rose-soft), var(--color-amber-soft));"
      >
      </div>
      <div class="aspect-4/5 overflow-hidden rounded-3xl border border-border bg-surface">
        <img src="/images/mor-photo.png" alt="Mor Naveh" class="h-full w-full object-cover" />
      </div>
    </div>

    <div>
      <p class="font-hand text-lg font-normal text-[#302e2c]/60">Hi, I'm Mor</p>
      <h1 class="font-display mt-6 text-6xl font-normal text-balance text-ink">
        I make complex things feel <span class="font-hand font-normal">simple</span>.
      </h1>
      <p class="mt-6 text-lg font-light text-[#302e2c]/60">
        Startup or enterprise, I design experiences that work for your users and deliver results.
      </p>
      <div class="mt-8 flex gap-4">
        <a href="/services#contact" class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-accent">
          Book a free intro call
        </a>
        <a href="/services" class="rounded-full border border-border px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-accent">
          View services
        </a>
      </div>
    </div>
  </section>

  <section id="work" class="mx-auto max-w-[1400px] px-6 pb-48">
    <h2 class="font-display text-4xl font-normal text-ink">Selected work</h2>
    <div class="mt-8 flex flex-col gap-6">
      {
        projects.slice(0, 3).map((project, i) => (
          <ProjectCard project={project} i={i} />
        ))
      }
    </div>
    <div class="mt-10 flex justify-center">
      <a href="/case-studies" class="rounded-full border border-ink/30 px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ink">
        View all case studies →
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 pb-48">
    <h2 class="font-display text-center text-4xl font-normal text-ink">My process</h2>
    <div class="mx-auto mt-8 flex max-w-2xl flex-col">
      {
        process.map((p, i) => (
          <div class="flex gap-5">
            <div class="flex flex-col items-center">
              <span
                class="font-display inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-ink"
                style={`background: var(--color-${swatches[i % swatches.length]});`}
              >
                {p.step}
              </span>
              {i < process.length - 1 && <span class="my-2 w-px grow bg-border" />}
            </div>
            <div class={i < process.length - 1 ? "pb-10" : ""}>
              <h3 class="font-display mt-1 text-base font-semibold text-ink">{p.title}</h3>
              <p class="mt-2 text-sm text-muted">{p.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="pb-48">
    <div class="relative left-1/2 w-screen -translate-x-1/2 py-16" style="background: var(--color-sage-soft);">
      <div class="mx-auto max-w-[1400px] px-6">
        <div class="mx-auto grid max-w-[1000px] gap-6 md:grid-cols-[200px_175px_1fr] md:items-start">
          <div class="overflow-hidden rounded-2xl border border-border">
            <img src="/images/mor-about.png" alt="Mor Naveh" class="h-auto w-full" />
          </div>
          <div class="flex flex-col gap-6">
            <div class="overflow-hidden rounded-2xl border border-border">
              <img src="/images/mor-about-2.png" alt="Mor Naveh in a witch costume" class="h-auto w-full" />
            </div>
            <div class="overflow-hidden rounded-2xl border border-border">
              <img src="/images/mor-about-3.png" alt="Mor Naveh with her dog" class="h-auto w-full" />
            </div>
          </div>
          <div>
            <h2 class="font-display text-4xl font-normal text-ink">About me</h2>
            <p class="mt-3 text-sm text-ink/80">
              I'm a product designer based in Israel, and I've been an information systems engineer since 2006. I help teams of every size turn complex ideas into clear, user-friendly products that deliver results.<br />Off-screen, I'll be walking my dog, hunting for good desserts, or counting down the days to Halloween.
            </p>
            <a
              href="/about"
              class="mt-5 inline-flex items-center gap-1.5 rounded-full border border-ink/20 bg-bg px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-ink"
            >
              More about me →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 pb-48">
    <div class="flex items-baseline justify-between">
      <h2 class="font-display text-4xl font-normal text-ink">Testimonials</h2>
      <div class="flex gap-2">
        <button
          type="button"
          data-testimonial-scroll="prev"
          aria-label="Previous testimonial"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-ink transition-colors hover:border-ink"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 6-6 6 6 6" /></svg>
        </button>
        <button
          type="button"
          data-testimonial-scroll="next"
          aria-label="Next testimonial"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-ink transition-colors hover:border-ink"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </button>
      </div>
    </div>
    <div
      id="testimonials-track"
      class="-ml-6 mt-8 flex snap-x snap-mandatory items-start gap-6 overflow-x-auto scroll-smooth pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        testimonials.map((t, i) => (
          <div class="w-fit max-w-[480px] shrink-0 snap-start sm:max-w-[560px]">
            <Testimonial quote={t.quote} name={t.name} title={t.title} company={t.company} id={`testimonial-${i}`} />
          </div>
        ))
      }
    </div>
  </section>

  <script>
    const track = document.getElementById("testimonials-track");
    document.querySelectorAll("[data-testimonial-scroll]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const direction = btn.getAttribute("data-testimonial-scroll") === "next" ? 1 : -1;
        track?.scrollBy({ left: direction * 356, behavior: "smooth" });
      });
    });
  </script>

  <section id="contact" class="pb-48">
    <ContactCTA />
  </section>
</Layout>
