---
import Layout from "../../layouts/Layout.astro";
import { logos } from "../../data/logos";
import { heWork } from "../../data/he-work";
import { whatsappUrl } from "../../data/he";
import Testimonials from "../../components/Testimonials.astro";

const swatches = ["indigo-soft", "rose-soft", "sage-soft", "amber-soft"] as const;

// three audiences, each card says how I help them. Companies and public bodies share /he/organizations
const doors = [
  {
    title: "ארגונים ציבוריים",
    text: "איך אפשר לחבר בין מערכות ולשפר תהליכים עבור הציבור וגם עבור הצוות? עם חוויית משתמש טובה.\nכל אתגר יכול להיות הזדמנות לשיפור, בואו נעשה את זה ביחד. ",
    href: "/he/organizations",
    color: "rose-soft",
  },
  {
    title: "חינוך, קהילה ועמותות",
    text: "הרשמה לחוג, טופס לטיול או מידע לתחילת השנה - כשהם ברורים, הורים ותלמידים מסתדרים לבד והצוות מתפנה לעיקר.\nבואו נדבר, אני יכולה לעזור לזה לקרות.",
    href: "/he/community",
    color: "sage-soft",
  },
  {
    title: "חברות ועסקים",
    text: "מוצר יכול להיות מורכב ועדיין ברור למשתמשים וגם לצוות הפיתוח. אני כאן כדי לתרגם את הדרישות לתהליכים שעובדים.\nביחד נבנה מוצרים שמשיגים את המטרה.",
    href: "/he/organizations",
    color: "amber-soft",
  },
];

const steps = [
  {
    title: "היכרות",
    text: "כל פרויקט מתחיל בסקרנות. אני לומדת להכיר את העסק שלכם, את המשתמשים ואת החשיבה שמאחורי המוצר. עיצוב טוב מתחיל בהבנה של הבעיה האמיתית, עוד לפני שחושבים על פתרונות.",
  },
  {
    title: "מיקוד",
    text: "בשלב הבא אני מצמצמת למה שהכי חשוב ומחברת את צוותי המוצר, הפיתוח ובעלי העניין סביב מטרה משותפת. כשהכיוון מוסכם על כולם מההתחלה, העבודה מתקדמת מהר ובלי חיכוכים.",
  },
  {
    title: "ניסוי ובדיקה",
    text: "אני אוהבת להפוך רעיונות למשהו מוחשי כבר בשלב מוקדם, ולהציג אותם למשתמשים אמיתיים בעזרת פרוטוטייפים. בדיקה מוקדמת הופכת הנחות לעובדות, ומגלה בעיות כשעוד קל לתקן אותן.",
  },
  {
    title: "מסירה",
    text: "אני מעצבת עם מחשבה על היישום: עיצוב ברור, מוקפד ומוכן לפיתוח. אפשר לסיים כאן, אבל המסירה לא חייבת להיות סוף הדרך. כשמגיעים פידבק ונתונים מהשטח, אפשר לשפר ולדייק כדי שהמוצר ימשיך לשרת את המטרות העסקיות של העסק.",
  },
];---

<Layout
  lang="he"
  title="מור נוה - אפיון ועיצוב חוויית משתמש"
  description={[
    "מאפיינת חוויית משתמש ומהנדסת מערכות מידע מאז 2006.",
    "מערכות, טפסים ותהליכים מסובכים, פשוטים לשימוש.",
  ].join(" ")}
>
  <section class="mx-auto grid max-w-[1400px] grid-cols-[104px_1fr] items-center gap-x-6 px-6 pt-14 pb-32 md:grid-cols-[320px_1fr] md:gap-24 md:pt-20">
    <div class="relative row-span-2 md:row-span-1">
      <div
        class="absolute -inset-3 -z-10 rounded-[60%_40%_55%_45%/45%_55%_40%_60%] md:-inset-6"
        style="background: linear-gradient(135deg, var(--color-rose-soft), var(--color-amber-soft));"
      >
      </div>
      <div class="aspect-4/5 overflow-hidden rounded-2xl border border-border bg-surface md:rounded-3xl">
        <img src="/images/mor-photo.webp" alt="מור נוה" class="h-full w-full object-cover" />
      </div>
    </div>

    <div class="contents md:block">
      <p class="font-hand self-end text-[1.4375rem] font-bold text-ink/60">
        היי, אני מור
      </p>
      <h1 class="font-display mt-2 self-start text-[1.75rem] leading-[1.15] font-normal text-ink md:mt-6 md:text-5xl md:leading-tight md:text-balance">
        אני הופכת רעיונות לעיצוב שעובד.
      </h1>
      <p class="col-span-2 mt-8 text-lg text-ink/80 md:mt-6">
       מומחית לחווית משתמש מעל 10 שנים ומהנדסת מערכות מידע מאז 2006. ביחד נהפוך רעיונות ואתגרים לפתרונות  שעובדים יותר טוב עבור כולם.
      </p>
      <div class="col-span-2 mt-8 flex flex-wrap gap-4 whitespace-nowrap">
        <a href={whatsappUrl} target="_blank" rel="noopener" class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-ink/80">בואו נדבר</a>
        <a href="/he/work" class="rounded-full border border-border px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ink">לעבודות שלי</a>
      </div>
    </div>
  </section>

  <section class="mb-32 bg-surface">
    <div class="mx-auto flex max-w-[1400px] flex-wrap items-center justify-center gap-x-10 gap-y-4 px-6 py-6">
      <p class="font-hand text-[1.375rem] font-bold text-ink/85">
      קצת מהנסיון שלי:
      </p>
      <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
        {logos.map((l) => (
          <li>
            <img src={`/logos/${l.file}`} alt={l.name} class={`${l.h} w-auto opacity-60 grayscale mix-blend-multiply transition hover:opacity-100 hover:grayscale-0`} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 pb-40">
    <h2 class="font-display text-4xl font-normal text-ink">
     למי זה יכול להתאים
    </h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        doors.map((d) => (
          <a href={d.href} class="group flex flex-col rounded-3xl p-8 transition-transform hover:-translate-y-0.5" style={`background: var(--color-${d.color});`}>
            <h3 class="font-display text-2xl font-semibold text-ink">{d.title}</h3>
            <p class="mt-3 grow text-lg whitespace-pre-line text-ink/80">{d.text}</p>
            <span class="mt-6 inline-flex w-fit items-center gap-1.5 rounded-full border border-ink/20 bg-bg px-5 py-2.5 text-sm font-medium text-ink transition-colors group-hover:border-ink">
              למידע נוסף ←
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <Testimonials title="המלצות" />

  <section id="work" class="mx-auto max-w-[1400px] scroll-mt-24 px-6 pb-40">
    <h2 class="font-display text-4xl font-normal text-ink">
      עבודות נבחרות
    </h2>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        heWork.map((w) => (
          <a href={`${w.enHref}?from=he`} class="group flex flex-col overflow-hidden rounded-3xl transition-transform hover:-translate-y-0.5" style={`background: var(--color-${w.color});`}>
            <div class="relative aspect-video">
              <div class="absolute inset-0 flex items-center justify-center">
                <img src={w.image} alt="" class="h-[80%] w-auto max-w-[85%] rounded-xl object-contain" />
              </div>
            </div>
            <div class="flex grow flex-col p-8 pt-2">
              <div class="grow pb-6">
                <span class="inline-block rounded-full bg-bg/70 px-3 py-1 text-xs font-medium text-ink/70">
                  באנגלית
                </span>
                <h3 class="font-display mt-3 text-2xl font-semibold text-ink">
                  {w.title}
                </h3>
                {/* optional Hebrew line: delete `short` in he-work.ts and the card still works */}
                {w.short && <p class="mt-2 text-lg text-ink/80">{w.short}</p>}
              </div>
              <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-ink/20 bg-bg px-5 py-2.5 text-sm font-medium text-ink transition-colors group-hover:border-ink">
                לקריאה ←
              </span>
            </div>
          </a>
        ))
      }
    </div>
    <div class="mt-10 flex flex-col items-center gap-4 text-center">
      <p class="text-lg text-ink/80">
       אשמח לספר עוד על כל אחד מהפרויקטים בשיחה.
      </p>
      <a href={whatsappUrl} target="_blank" rel="noopener" class="rounded-full bg-ink px-6 py-3 text-sm font-medium whitespace-nowrap text-bg transition-colors hover:bg-ink/80">בואו נדבר</a>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 pb-40">
    <h2 class="font-display text-center text-4xl font-normal text-ink">
      איך זה עובד
    </h2>
    <div class="mx-auto mt-8 flex max-w-2xl flex-col">
      {
        steps.map((s, i) => (
          <div class="flex gap-5">
            <div class="flex flex-col items-center">
              <span
                class="font-display inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-ink"
                style={`background: var(--color-${swatches[i % swatches.length]});`}
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              {i < steps.length - 1 && <span class="my-2 w-px grow bg-border" />}
            </div>
            <div class={i < steps.length - 1 ? "pb-10" : ""}>
              <h3 class="font-display mt-1 text-lg font-semibold text-ink">{s.title}</h3>
              <p class="mt-1 text-lg text-muted">{s.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
