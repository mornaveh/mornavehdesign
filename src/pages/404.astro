---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found - Mor Naveh">
  <section class="mx-auto flex max-w-[1400px] flex-col items-center px-6 pt-16 pb-48 text-center">
    <img src="/images/ghost-404.svg" alt="A smiling ghost riding a broom" class="mb-8 h-56 w-auto" />
    <p class="font-hand text-xl font-normal text-ink/60">404 - page not found</p>
    <h1 class="font-display mt-4 text-5xl font-normal text-balance text-ink">Boo! You've flown off the user flow.</h1>
    <p class="mt-6 max-w-xl text-base text-balance text-ink/80">
      Hop on, the ghost knows the way back.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4 whitespace-nowrap">
      <a href="/" class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-ink/80">Return home</a>
      <a href="/case-studies" class="rounded-full border border-border px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ink">
        View case studies
      </a>
    </div>
  </section>
</Layout>
