---
import Layout from "../layouts/Layout.astro";
import Testimonial from "../components/Testimonial.astro";

const swatches = ["indigo-soft", "rose-soft", "sage-soft", "amber-soft"] as const;

const tracks = [
  {
    name: "Find the focus",
    tagline: "Where to focus for the biggest impact.",
    priceLabel: "From",
    price: "$1.8K",
    cta: "Find your focus",
    services: [
      {
        name: "UX audit",
        description:
          "A review of usability issues in your product and recommended fixes, in order of priority.",
      },
      {
        name: "Design sprint",
        description:
          "A well-defined project in a few working days: users, pain points, goals, KPIs, key user flows, and more.",
      },
      {
        name: "User research",
        description:
          "Clear user insights for smarter product decisions.",
      },
    ],
  },
  {
    name: "Design the flow",
    tagline: "From concept to dev-ready designs.",
    priceLabel: "From",
    price: "$3K",
    cta: "Let's design",
    services: [
      {
        name: "Flow design",
        description:
          "Designed from scratch or an existing flow, based on your organizational knowledge. Delivered as a prototype, full Figma file, or both.",
      },
      {
        name: "Full UX process",
        description:
          "Full project definitions, research, designs, and usability testing.",
      },
    ],
  },
  {
    name: "Ongoing partnership",
    tagline: "A design partner embedded with your team.",
    priceLabel: "Pricing varies",
    cta: "Let's work together",

    services: [
      {
        name: "Retainer",
        description:
          "Monthly ongoing work - research, design, reviews, and everything in between, with a consistent partner who knows your product.",
      },
      {
        name: "Hourly",
        description: "Flexible support for smaller tasks (design updates, fixes, reviews, etc.), at an hourly rate.",
      },
    ],
  },
];

const steps = [
  { title: "Intro call", text: "A free 30-minute chat about your product, what you'd like to improve, and what success would look like." },
  { title: "Deliverables and timelines", text: "I send a written proposal detailing milestones, timelines, and pricing." },
  { title: "The work starts", text: "Once the proposal is signed and the deposit is made, the project starts according to the milestones noted." },
  { title: "Tailored collaboration", text: "We'll collaborate at whatever pace and depth works best for you, touching base at key stages to make sure everything stays on track." },
  { title: "Handoff & what comes after", text: "You'll receive fully prepared assets and clear guidelines for your team run with. From there, I can stay on board to advise or help you iterate as you grow." },
];

// TODO(Mor): fill in real questions & answers
const faqs = [
  {
    q: "Which is the right track for me?",
    a: `If you're not sure which track is right for you, <a href="#contact" class="underline">reach out</a> for a free 30-minute call and we'll figure it out together. But in a nutshell:
      <ul class="mt-3 list-disc space-y-1 pl-5">
        <li><strong class="font-medium text-ink">Find the focus</strong>: you're not sure what to build, or what to fix first.</li>
        <li><strong class="font-medium text-ink">Design the flow</strong>: you know what you want designed.</li>
        <li><strong class="font-medium text-ink">Ongoing partnership</strong>: you'd like a designer working alongside your team over time.</li>
      </ul>`,
  },
  {
    q: "What's the process for payment?",
    a: "Project work starts with an upfront deposit and remaining payments are tied to key deliverables. Retainers are billed monthly. We'll agree on the exact payment schedule before we kick off.",
  },
  {
    q: "How long does a project take?",
    a: `While duration depends on project scope and how fast we can iterate, you can generally expect these timeframes:
      <ul class="mt-3 list-disc space-y-1 pl-5">
        <li><strong class="font-medium text-ink">Find the focus projects</strong>: about two weeks</li>
        <li><strong class="font-medium text-ink">Flow design</strong>: 6-8 weeks</li>
        <li><strong class="font-medium text-ink">Full UX process</strong>: 10-12 weeks</li>
      </ul>`,
  },
  { q: "How do you use AI in your work?",
    a: "I love using AI for exploring ideas quickly - whether that's drafting copy options, organizing research, or building well-rounded and accurate prototypes. Working this way lets test designs with users earlier and iterate without getting stuck.<br /><br />AI is a very powerful tool, and like any tool, the results depend on who is using it. It handles the heavy lifting when I want to work fast, leaving me with more time to focus on strategy, empathy, and making sure the final product has great experience and caters to the business goals. " },
  { q: "How fast can you get up to speed on our product?",
    a: "Fast. As the only UX designer at the Citibank accelerator, I started a new project every few weeks, so getting up to speed fast was part of the job.<br />There are usually opportunities for improvement which I spot quickly, and more complex one which come up as I learn more about your product and users. This way I keep adding value as my understanding grows." },
  { q: "Do I get Figma files?",
    a: "If you want them, yes. Figma files can be part of the deliverables. If a working prototype is all you need, that works too. We’ll agree at the start on what fits your team best, and I’ll shape the deliverables around that so you get what you need as quickly as possible." },
  { q: "How do you work with product and engineering?",
    a: "However works best for your team. If you’d like me closely involved, I’ll work with PMs to keep the design tied to product goals and with developers early on so it’s realistic to build. My background as an information systems engineer helps me speak both languages and make sure nothing gets lost between them. If you’d rather I work more independently and hand off finished designs, that works too." },
];
---

<Layout title="Services - Mor Naveh">
  <section class="mx-auto max-w-[1400px] px-6 pt-20 pb-48">
    <h1 class="max-w-4xl font-display text-5xl font-normal text-balance text-ink">Get a clear direction for your product, and a design your team can build.</h1>
    <p class="mt-6 max-w-2xl text-lg font-light text-[#302e2c]/60">
      I help teams turn hazy problems into focused decisions and well-crafted flows, so you can spend your time
      shipping what matters.<br /><br /> Pick the track that fits where you are, or let's talk and find the
      right fit together.
    </p>
    <a
      href="#contact"
      class="mt-8 inline-flex w-fit items-center gap-1.5 rounded-full bg-ink px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-accent"
    >
      Book a free intro call
    </a>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 pb-28">
    <h2 class="mb-10 font-display text-4xl font-normal text-ink">Tracks and pricing</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {
        tracks.map((track, i) => (
          <div class="flex flex-col overflow-hidden rounded-3xl" style={`border: 2px solid var(--color-${swatches[(i + 1) % swatches.length]});`}>
            <div class="p-8" style={`background: var(--color-${swatches[(i + 1) % swatches.length]});`}>
              <h2 class="font-display text-2xl font-normal text-ink">{track.name}</h2>
              <p class="mt-2 text-sm text-ink/80">{track.tagline}</p>
              <p class="mt-4 text-2xl font-light leading-none tracking-tight text-ink"><span class="mr-1.5 text-sm font-normal tracking-normal text-ink/70">{track.priceLabel}</span>{track.price}</p>
            </div>
            <ul class="flex-1 space-y-5 p-8">
              {track.services.map((s) => (
                <li>
                  <h3 class="font-display text-base font-semibold text-ink">{s.name}</h3>
                  <p class="mt-1 text-sm text-ink/80">{s.description}</p>
                </li>
              ))}
            </ul>
            <a
              href={`?track=${encodeURIComponent(track.name)}#contact`}
              class="mx-8 mb-8 inline-flex w-fit items-center gap-1.5 rounded-full border border-ink/30 px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ink"
            >
              {track.cta} →
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 pb-28">
    <div class="mx-auto -my-6 max-w-3xl text-center [&>div]:items-center">
        <Testimonial
          quote={"Mor has a rare ability to turn ambiguous ideas and raw user feedback into clear, intuitive products, and she does it fast without ever compromising on quality. She's a true partner to product."}
          name="Limor Peleg"
          title="Product Manager, Agentic Solutions"
          company="Workday"
          id="services-testimonial"
          color="rose-soft"
        />
    </div>
  </section>

  <section id="hello-to-handoff" class="scroll-mt-24 mx-auto max-w-[1400px] px-6 pb-48">
    <h2 class="mb-10 font-display text-4xl font-normal text-ink">What to expect when working with me</h2>
    <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
      {
        steps.map((s, i) => (
          <li class="border-t-4 pt-5" style={`border-color: var(--color-${swatches[(i + 1) % swatches.length]});`}>
            <span class="font-display text-3xl font-light text-ink/40">{i + 1}</span>
            <h3 class="mt-3 font-display text-base font-semibold text-ink">{s.title}</h3>
            <p class="mt-2 text-sm text-ink/80">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 pb-48">
    <div class="grid gap-10 md:grid-cols-[1fr_2fr]">
    <h2 class="font-display text-4xl font-normal text-ink">FAQs</h2>
    <div class="divide-y divide-border border-y border-border">
      {
        faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-base text-ink marker:content-none">
              {f.q}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 transition-transform group-open:rotate-180">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="mt-3 pr-12 text-sm text-ink/80" set:html={f.a} />
          </details>
        ))
      }
    </div>
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-[1400px] scroll-mt-24 px-6 pb-48">
    <h2 class="font-display text-4xl font-normal text-ink">How can I help?</h2>
    <p class="mt-2 max-w-xl text-sm text-ink/80">Tell me what's on your mind or that you'd like a free intro call, let's tackle the challenge together.</p>
    <!-- ponytail: no form backend yet — point action at Formspree/Web3Forms (or a Vercel function) before launch -->
    <form action="#" method="POST" class="mt-10 grid max-w-2xl gap-5 sm:grid-cols-2">
      <label class="flex flex-col gap-2 text-sm font-medium text-ink">
        Name
        <input name="name" required autocomplete="name" class="rounded-2xl border border-border px-4 py-3 font-normal focus:border-accent focus:outline-none" />
      </label>
      <label class="flex flex-col gap-2 text-sm font-medium text-ink">
        Email
        <input name="email" type="email" required autocomplete="email" class="rounded-2xl border border-border px-4 py-3 font-normal focus:border-accent focus:outline-none" />
      </label>
      <label class="flex flex-col gap-2 text-sm font-medium text-ink">
        <span>Company <span class="font-normal text-muted">(optional)</span></span>
        <input name="company" autocomplete="organization" class="rounded-2xl border border-border px-4 py-3 font-normal focus:border-accent focus:outline-none" />
      </label>
      <label class="flex flex-col gap-2 text-sm font-medium text-ink">
        Track
        <select id="track" name="track" class="appearance-none rounded-2xl border border-border bg-bg bg-[length:16px] bg-[position:right_1rem_center] bg-no-repeat py-3 pr-10 pl-4 font-normal focus:border-accent focus:outline-none"
          style="background-image: url(&quot;data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231C1B2E' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='m6 9 6 6 6-6'/%3E%3C/svg%3E&quot;);">
          <option>Not sure yet</option>
          {tracks.map((t) => <option>{t.name}</option>)}
        </select>
      </label>
      <label class="flex flex-col gap-2 text-sm font-medium text-ink sm:col-span-2">
        <span>What's on your mind? <span class="font-normal text-muted">(optional)</span></span>
        <textarea name="message" rows="5" class="rounded-2xl border border-border px-4 py-3 font-normal focus:border-accent focus:outline-none"></textarea>
      </label>
      <button
        type="submit"
        class="w-fit rounded-full bg-ink px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-accent"
      >
        Send
      </button>
    </form>
  </section>

  <script>
    const track = new URLSearchParams(location.search).get("track");
    if (track) (document.getElementById("track") as HTMLSelectElement).value = track;
  </script>
</Layout>
